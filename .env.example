# Laravel API base URL — server-side only, never exposed to the browser
LARAVEL_API_URL=http://localhost:8000/api

# Public site URL, used for canonical URLs, sitemap and schema.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Laravel sends with POST /api/revalidate to purge cache tags
REVALIDATE_SECRET=change-me-in-every-environment

# Where product media actually lives. Defaults to the Laravel origin; point it
# at a CDN or object store in production. Served through this app at /media.
MEDIA_BASE_URL=http://localhost:8000
